# ── Required ────────────────────────────────────────────────────────────────
# Anthropic API key — get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Telegram (optional — needed for --telegram flag) ─────────────────────────
# Step 1: Create a bot via @BotFather in Telegram → copy the token below
# Step 2: Start a chat with your bot (send /start)
# Step 3: Get your chat ID:
#   - Personal: message @userinfobot
#   - Group: add bot to group, send a message, then open
#     https://api.telegram.org/bot<TOKEN>/getUpdates  and find "chat":{"id":...}
#   - Channel: use format -100XXXXXXXXXX
# Step 4: Test with:  python polymarket_bot.py --tg-test
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUvwXYZ
TELEGRAM_CHAT_ID=123456789

# ── Optional: PolyMarket API overrides (defaults already set in code) ────────
# POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_API=https://clob.polymarket.com

# ── All other data sources are FREE with no API key required ────────────────
# News    : Google News RSS + BBC RSS  (no key)
# Crypto  : CoinGecko public API       (no key, rate-limited ~10 req/min)
# Sports  : TheSportsDB free tier      (no key)
# Weather : Open-Meteo                 (no key, completely free)
