# ── Required ────────────────────────────────────────────────────────────────
# Anthropic API key — get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Optional: PolyMarket API overrides (defaults already set in code) ────────
# POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_API=https://clob.polymarket.com

# ── All other data sources are FREE with no API key required ────────────────
# News    : Google News RSS + BBC RSS  (no key)
# Crypto  : CoinGecko public API       (no key, rate-limited ~10 req/min)
# Sports  : TheSportsDB free tier      (no key)
# Weather : Open-Meteo                 (no key, completely free)
